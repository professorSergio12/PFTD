# Copy this file to .env and fill in real values

# Server
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/pftd

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# Capacity in minutes. 480 = one 8h working day.
# Use 2400 for a 5-day working week.
DAILY_CAPACITY=480

# Workday start used for the "free after" calculation (24h format)
WORKDAY_START=09:00